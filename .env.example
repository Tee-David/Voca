# Voca configuration template
# Copy the variables you need into frontend/.env.local for local development.
# Never commit real credentials.

# Core hosted-mode database
# Voca's local reader/TTS path does not require the optional AI or remote TTS
# providers below. Server-backed library/account features currently use Prisma.
DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:5432/voca?sslmode=require"

# Authentication
# Generate a unique development secret, for example with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-local-development-secret"
NEXTAUTH_URL="http://localhost:3000"

# Optional S3-compatible object storage, current adapter: Cloudflare R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Optional remote TTS fallback. Leave empty for browser-local Kokoro TTS.
HF_TTS_URL=""

# Optional AI features. Leave unset to keep AI features disabled.
GROQ_API_KEY=""

# Capacitor/mobile only. Web builds normally leave this empty for same-origin API calls.
# Set it to the Voca API deployment you control when building the Android client.
NEXT_PUBLIC_API_BASE_URL=""
